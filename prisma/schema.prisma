generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id
  name          String
  email         String
  emailVerified Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  billing       BillingAccount?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum AssetSource {
  UPLOAD
  GENERATED
}

enum AssetStatus {
  PENDING
  READY
  FAILED
  DELETING
}

enum RevisionAuthorType {
  SYSTEM
  AGENT
  USER
}

model Project {
  id                String   @id @default(cuid())
  userId            String
  title             String
  currentRevisionId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRevision   ProjectRevision?          @relation("ProjectHead", fields: [id, currentRevisionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  messages          ChatMessage[]
  chatRuns          ChatRun[]
  contextCheckpoint ProjectContextCheckpoint?
  workspaceLease    ProjectWorkspaceLease?
  assets            Asset[]
  fileBlobs         ProjectFileBlob[]
  revisions         ProjectRevision[]         @relation("ProjectRevisions")

  @@index([userId, updatedAt])
}

model ProjectWorkspaceLease {
  projectId String   @id
  token     String
  expiresAt DateTime
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Asset {
  id        String      @id @default(uuid())
  projectId String
  objectKey String      @unique
  filename  String
  mediaType String
  size      Int
  source    AssetSource @default(UPLOAD)
  status    AssetStatus @default(PENDING)
  claimedAt DateTime?
  cacheKey  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, source, claimedAt, updatedAt])
  @@index([projectId, cacheKey])
}

model ChatMessage {
  id         String          @id @default(cuid())
  projectId  String
  role       ChatMessageRole
  /// Ordered, extensible UI message parts. Their variants are intentionally
  /// validated in application code rather than fixed in the database schema.
  parts      Json
  /// Full assistant turn for model replay. The transcript stays small.
  modelParts Json?
  metadata   Json?
  revisionId String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  project           Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision          ProjectRevision?          @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  contextCheckpoint ProjectContextCheckpoint?
  chatRuns          ChatRun[]                 @relation("RunTarget")
  responseRuns      ChatRun[]                 @relation("RunResponse")

  @@index([projectId, createdAt, id])
  @@index([revisionId])
}

enum ChatRunStatus {
  RUNNING
  COMMITTED
  FAILED
  STOPPED
}

model ChatRun {
  id                String        @id @default(uuid())
  projectId         String
  requestId         String
  status            ChatRunStatus @default(RUNNING)
  targetMessageId   String?
  responseMessageId String?
  submission        Json?
  resultRevisionId  String?
  /// Failed runs have no committed assistant message to read their activity from.
  failedActivity    Json?
  error             String?
  leaseExpiresAt    DateTime?
  stopRequestedAt   DateTime?
  finishedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responseMessage ChatMessage?       @relation("RunResponse", fields: [responseMessageId], references: [id], onDelete: Cascade)
  targetMessage   ChatMessage?       @relation("RunTarget", fields: [targetMessageId], references: [id], onDelete: SetNull)
  creditCharge    CreditTransaction?

  @@unique([projectId, requestId])
  @@index([projectId, createdAt, id])
  @@index([targetMessageId])
  @@index([responseMessageId])
}

model ProjectContextCheckpoint {
  projectId          String   @id
  throughMessageId   String   @unique
  /// Evidence-heavy compacted prefix plus any exact model-message tail created
  /// after compaction within the same agent run.
  checkpointMessages Json
  retainedAssetIds   String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  throughMessage ChatMessage @relation(fields: [throughMessageId], references: [id], onDelete: Cascade)
}

model ProjectFileBlob {
  id        String   @id @default(cuid())
  projectId String
  sha256    String
  objectKey String   @unique
  size      Int
  mediaType String   @default("text/plain")
  createdAt DateTime @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionFiles RevisionFile[]

  @@unique([projectId, sha256])
}

model ProjectRevision {
  id               String             @id @default(cuid())
  projectId        String
  parentRevisionId String?
  authorType       RevisionAuthorType
  summary          String
  createdAt        DateTime           @default(now())

  project        Project           @relation("ProjectRevisions", fields: [projectId], references: [id], onDelete: Cascade)
  currentFor     Project[]         @relation("ProjectHead")
  parentRevision ProjectRevision?  @relation("RevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  childRevisions ProjectRevision[] @relation("RevisionParent")
  files          RevisionFile[]
  messages       ChatMessage[]

  @@unique([projectId, id])
  @@index([projectId, createdAt])
  @@index([parentRevisionId])
}

model RevisionFile {
  revisionId String
  path       String
  blobId     String

  revision ProjectRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  blob     ProjectFileBlob @relation(fields: [blobId], references: [id], onDelete: Restrict)

  @@id([revisionId, path])
  @@index([blobId])
}

enum Plan {
  FREE
  STARTER
  PRO
  MAX
}

enum CreditTransactionKind {
  PLAN
  TOP_UP
  GENERATION
}

/// Simulated billing: purchases are recorded without a payment provider.
model BillingAccount {
  userId            String   @id
  plan              Plan     @default(FREE)
  credits           Int      @default(0)
  periodStartedAt   DateTime
  periodEndsAt      DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

/// Every change to a balance. A generation is charged once, through its run.
model CreditTransaction {
  id         String                @id @default(cuid())
  userId     String
  kind       CreditTransactionKind
  amount     Int
  priceCents Int                   @default(0)
  plan       Plan?
  chatRunId  String?               @unique
  createdAt  DateTime              @default(now())

  account BillingAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
  chatRun ChatRun?       @relation(fields: [chatRunId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
