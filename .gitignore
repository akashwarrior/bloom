# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local runtime data (browser profiles, caches)
/.data

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs/**/*.jsonl

# env files (can opt-in for committing if needed)
.env*

# benchmark worker copies and transient output
/benchmark/.runs/
/benchmark-results/**/logs/
/benchmark-results/**/source.tar.gz
/benchmark-results/summary-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma
